<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS — web.config: redirect HTTP -> HTTPS và header bảo mật.

  Đặt tại thư mục gốc của site (cùng cấp với index.html/Default.aspx).
  Cần module: URL Rewrite (tải riêng từ iis.net, không có sẵn trong IIS).

  LƯU Ý:
  - Cert không nằm trong file này. Cert gắn ở IIS Manager -> Bindings (443).
  - HSTS tăng dần: bắt đầu max-age=300.
  - Nếu site có API cho bên thứ ba gọi bằng http://, loại trừ đường dẫn API
    khỏi redirect, nếu không họ sẽ nhận 301 và mất body của POST.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- Cho ACME challenge đi qua, không redirect -->
        <rule name="ACME challenge passthrough" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/.*" />
          <action type="None" />
        </rule>

        <!-- HTTP -> HTTPS, giữ nguyên path và query -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <!-- Bỏ comment dòng dưới nếu muốn miễn trừ API webhook -->
            <!-- <add input="{REQUEST_URI}" pattern="^/api/webhook/" negate="true" /> -->
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}"
                  redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <!-- HSTS: tăng dần. max-age=300 lúc đầu, 31536000 khi đã chắc chắn. -->
        <add name="Strict-Transport-Security" value="max-age=300" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Xoá header lộ phiên bản -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- Chặn truy cập file cấu hình và thư mục ẩn -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment="App_Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
